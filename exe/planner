#!/usr/bin/env ruby
# frozen_string_literal: true

require 'planner'

context = Planner::Context.new(
  root: Pathname.pwd,
  home: Pathname(Dir.home),
  skills_dir: Planner::SkillCatalog::DIR,
  agent: Planner::Agents::Claude.new,
  stdin: $stdin,
  stdout: $stdout,
  clock: -> { Time.now }
)
exit Planner::CLI.new(context:).call(ARGV)
